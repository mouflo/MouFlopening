{
  "emby": {
    "host": "",
    "api_key": "your_emby_api_key_here",
    "scan_after_download": true,
    "timeout": 30
  },
  "themes": {
    "backup_dir": ""
  },
  "sources": {
    "animethemes": {
      "enabled": true,
      "priority": 1,
      "api_url": "https://api.animethemes.moe",
      "theme_types": [
        "OP",
        "ED"
      ]
    },
    "youtube": {
      "enabled": true,
      "priority": 2,
      "timeout": 60,
      "max_duration": 600
    },
    "local": {
      "enabled": false,
      "priority": 4,
      "search_paths": [
        "/mnt/media/Themes",
        "/home/user/Music/Themes"
      ]
    }
  },
  "matching": {
    "method": "fuzzy",
    "threshold": 70,
    "case_sensitive": false
  },
  "download": {
    "concurrent_downloads": 3,
    "retry_failed": true,
    "max_retries": 3,
    "timeout": 60
  },
  "organization": {
    "by_media_type": true,
    "folder_structure": "{media_type}/{title}/",
    "move_after_download": true
  },
  "logging": {
    "level": "INFO",
    "file": "mouflopening.log",
    "max_file_size": 10485760,
    "backup_count": 5
  },
  "database": {
    "type": "sqlite",
    "path": "mouflopening.db"
  },
  "scheduler": {
    "enabled": true,
    "interval_hours": 24,
    "scan_missing_interval_hours": 12
  },
  "library": {
    "auto_parent": "",
    "categories": [],
    "paths": [],
    "excluded": []
  },
  "audio": {
    "target_db": 89
  }
}
